# Copy to .env (git-ignored). Leave EXPO_PUBLIC_API_URL unset to use the built-in mock API.
# Cloud Run URL from: gcloud run services describe shopassist-api --region asia-south1 --format "value(status.url)"
# Local backend: http://<your-LAN-IP>:8080 (phone and PC on the same Wi-Fi)
EXPO_PUBLIC_API_URL=
