{
  "expo": {
    "name": "ShopAssist",
    "slug": "shopassist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shopassist",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.rajatbalyan.shopassist"
    },
    "android": {
      "package": "com.rajatbalyan.shopassist",
      "adaptiveIcon": {
        "backgroundColor": "#5B4CF0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B4CF0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#2B2752",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5B4CF0",
          "defaultChannel": "order-updates"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "557f0140-62a9-4cbc-b933-e59ea158a80f"
      }
    },
    "owner": "rajatbalyan",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/557f0140-62a9-4cbc-b933-e59ea158a80f"
    }
  }
}
