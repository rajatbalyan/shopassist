{
  "name": "shopassist-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "dev": "npm run sync-data && node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "build": "npm run sync-data && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.4.1",
    "@google/genai": "3.6.1",
    "@hono/node-server": "2.1.11",
    "expo-server-sdk": "8.0.0",
    "hono": "4.13.20",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
