# Copy to .env for local runs (`npm run dev` loads it). On Cloud Run these come from
# --set-env-vars / --set-secrets (see DEPLOY.md).
GCP_PROJECT_ID=your-project-id
# Vertex AI location for Gemini: the "global" endpoint (Cloud Run + Firestore live in asia-south1).
GCP_LOCATION=global
# gemini-3.8-flash is blocked for new projects; use 3.5 Flash-Lite.
GEMINI_MODEL=gemini-3.5-flash-lite
# Shared secret for /admin/* demo triggers (header x-admin-key).
ADMIN_KEY=change-me
# firestore (default) or memory (no GCP needed; data resets on restart).
STORE=firestore
# Named Firestore database to use (this project's database is "shopassist", not "(default)").
FIRESTORE_DATABASE_ID=shopassist
PORT=8080
# Optional: Expo access token if push security is enabled for the Expo project.
EXPO_ACCESS_TOKEN=
